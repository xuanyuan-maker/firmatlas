[Unit]
Description=FirmAtlas catalog crawl, export and publish cycle
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=firmatlas
Group=firmatlas
EnvironmentFile=/etc/firmatlas/server.env
ExecStart=/usr/local/libexec/firmatlas-cycle.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/firmatlas
StandardOutput=journal
StandardError=journal
