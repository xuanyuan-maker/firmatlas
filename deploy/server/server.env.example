# 复制到 /etc/firmatlas/server.env，设置为 root:firmatlas 0640。
FIRMATLAS_BIN=/usr/local/bin/firmatlas
FIRMATLAS_DATA_DIR=/var/lib/firmatlas
FIRMATLAS_EXPORT_ROOT=/var/lib/firmatlas/exports
FIRMATLAS_CATALOG_REPO=xuanyuan-maker/firmatlas-catalog
FIRMATLAS_ALLOW_PARTIAL=false
FIRMATLAS_EXPORT_RETENTION=5
# 认证来源通过受保护环境注入，例如：
# RUIJIE_TOKEN=（不要提交真实值）
